repositories:
    # PCL Dependencies
    src/external/pcl/external/pcl:
        type: git
        url: git@github.com:ros-perception/perception_pcl.git 
        version: 2.4.1 
    src/external/pcl/external/pcl_msgs:
        type: git
        url: git@github.com:ros-perception/pcl_msgs.git 
        version: 1.0.0 
    # foxglove bridge
    src/external/utils/misc/external/foxglove_bridge:
        type: git
        url: git@github.com:foxglove/ros-foxglove-bridge.git 
        version: 0.8.2
    # src/external/utils/misc/external/nav2_msgs:
    #     type: git
    #     url: git@github.com:ros-planning/navigation2.git
    #     version: humble
    src/external/utils/misc/external/pluginlib:
        type: git
        url: git@github.com:ros/pluginlib.git
        version: 5.2.2 
    src/external/utils/misc/external/xacro:
        type: git
        url: git@github.com:ros/xacro.git
        version: 2.0.10
